<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>

    <Product>Diskpart+</Product>
    <Authors>flyteongithub</Authors>
    <Company>flyteongithub</Company>
    <Copyright>Copyright (c) 2026 flyteongithub</Copyright>
    <RepositoryUrl>https://github.com/flyteongithub/diskpart-plus</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
