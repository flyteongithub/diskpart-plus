<Window x:Class="DiskpartPlus.App.Views.PlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review changes"
        Width="760" Height="660" MinWidth="600" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="RiskPill" CornerRadius="10" Padding="10,2" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="RiskText" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                </Border>
                <TextBlock x:Name="HeadingText" Style="{StaticResource HeaderText}" />
            </StackPanel>
            <TextBlock x:Name="SummaryText" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Before running: what will happen -->
        <ScrollViewer x:Name="ReviewPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="What will happen" Style="{StaticResource SectionText}" Margin="0,0,0,6" />
                <ItemsControl x:Name="StepsList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="IssuesHeader" Text="Things to know" Style="{StaticResource SectionText}" Margin="0,16,0,6" />
                <ItemsControl x:Name="IssuesList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{Binding Brush}" BorderThickness="3,0,0,0" Padding="10,4" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Kind}" Foreground="{Binding Brush}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander Header="The exact diskpart script" Margin="0,12,0,0">
                    <TextBox x:Name="ScriptBox"
                             IsReadOnly="True"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="12"
                             Margin="0,8,0,0"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- While running and after -->
        <DockPanel x:Name="RunPanel" Grid.Row="1" Visibility="Collapsed">
            <TextBlock x:Name="RunStatus" DockPanel.Dock="Top" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ProgressBar x:Name="RunProgress" DockPanel.Dock="Top" IsIndeterminate="True" Height="4" Margin="0,0,0,12" />
            <TextBox x:Name="OutputBox"
                     IsReadOnly="True"
                     FontFamily="{StaticResource MonoFont}"
                     FontSize="12"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
        </DockPanel>

        <!-- Typed confirmation -->
        <StackPanel x:Name="ConfirmPanel" Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="ConfirmLabel" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBox x:Name="ConfirmBox" FontFamily="{StaticResource MonoFont}" TextChanged="ConfirmBox_TextChanged" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="StopButton" Content="Stop" Visibility="Collapsed" MinWidth="104" Margin="0,0,8,0" Click="Stop_Click" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="104" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="RunButton" Content="Run" MinWidth="104" Click="Run_Click" />
        </StackPanel>
    </Grid>
</Window>
