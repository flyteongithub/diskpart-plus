<Window x:Class="DiskpartPlus.App.Views.PlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diskpart+"
        Width="680" Height="520" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="HeadingText" Style="{StaticResource HeaderText}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Before running -->
        <ScrollViewer x:Name="ReviewPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="StepsList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl x:Name="IssuesList" Focusable="False" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{Binding Brush}" BorderThickness="3,0,0,0" Padding="10,4" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander Header="Script" Margin="0,10,0,0">
                    <TextBox x:Name="ScriptBox"
                             IsReadOnly="True"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="12"
                             Margin="0,8,0,0"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- While running and after -->
        <DockPanel x:Name="RunPanel" Grid.Row="1" Visibility="Collapsed">
            <TextBlock x:Name="RunStatus" DockPanel.Dock="Top" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ProgressBar x:Name="RunProgress" DockPanel.Dock="Top" IsIndeterminate="True" Height="4" Margin="0,0,0,12" />
            <TextBox x:Name="OutputBox"
                     IsReadOnly="True"
                     FontFamily="{StaticResource MonoFont}"
                     FontSize="12"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
        </DockPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="StopButton" Content="Stop" Visibility="Collapsed" MinWidth="104" Margin="0,0,8,0" Click="Stop_Click" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="104" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="RunButton" Content="Run" MinWidth="120" Click="Run_Click" />
        </StackPanel>
    </Grid>
</Window>
