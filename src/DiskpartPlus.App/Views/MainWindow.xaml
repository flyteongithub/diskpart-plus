<Window x:Class="DiskpartPlus.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DiskpartPlus.App.Controls"
        xmlns:vm="clr-namespace:DiskpartPlus.App.ViewModels"
        Title="Diskpart+"
        Width="1240" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/DiskpartPlus.ico">

    <Grid Margin="20,12,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Image Source="/Assets/DiskpartPlus.png" Width="32" Height="32" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Diskpart+" Style="{StaticResource AppTitleText}" />
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="10,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Click="OpenMenu_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Virtual disk" />
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Margin="8,2,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Create..." Command="{Binding CreateVhdCommand}" ToolTip="New .vhdx or .vhd file." ToolTipService.ShowOnDisabled="True" />
                            <MenuItem Header="Attach..." Command="{Binding AttachVhdCommand}" ToolTip="Mount a .vhdx or .vhd file." ToolTipService.ShowOnDisabled="True" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" ToolTip="Re-read all disks." Margin="0,0,8,0" />
                <Button Content="About" Command="{Binding AboutCommand}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Disk list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Disks" Style="{StaticResource SectionText}" Margin="8,4,0,8" />
                    <ListBox ItemsSource="{Binding Disks}"
                             SelectedItem="{Binding SelectedDisk}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DiskViewModel}">
                                <Grid Margin="2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="10" Background="{Binding IconBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding IconText}" Foreground="White" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <ItemsControl ItemsSource="{Binding Badges}" Margin="0,4,0,0" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:Badge}">
                                                    <Border Background="{Binding Brush}" CornerRadius="4" Padding="6,1" Margin="0,0,4,2">
                                                        <TextBlock Text="{Binding Text}" Foreground="White" FontSize="11" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Nothing selected -->
            <TextBlock Grid.Column="2"
                       Text="Pick a disk."
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding NoDiskSelected, Converter={StaticResource BoolToVisibility}}" />

            <!-- Selected disk. Scrolls when the window is too short to fit everything. -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasDiskSelected, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                <!-- Disk header and disk actions -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedDisk.Title}" Style="{StaticResource HeaderText}" />
                        <TextBlock Text="{Binding SelectedDisk.Subtitle}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding SelectedDisk.Details}" Style="{StaticResource CaptionText}" />

                        <ItemsControl ItemsSource="{Binding SelectedDisk.Badges}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:Badge}">
                                    <Border Background="{Binding Brush}" CornerRadius="4" Padding="8,2" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Text}" Foreground="White" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The partition bar -->
                        <ListBox ItemsSource="{Binding SelectedDisk.Segments}"
                                 SelectedItem="{Binding SelectedSegment}"
                                 Height="68"
                                 Margin="0,12,0,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:ProportionalPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="controls:ProportionalPanel.Weight" Value="{Binding Weight}" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Outline" Padding="2" CornerRadius="7" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource SelectionOutlineBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Cursor" Value="Hand" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SegmentViewModel}">
                                    <Border Background="{Binding Fill}"
                                            BorderBrush="{Binding Stroke}"
                                            BorderThickness="{Binding StrokeThickness}"
                                            CornerRadius="5"
                                            Padding="8,6"
                                            ToolTip="{Binding ToolTip}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" Foreground="{Binding TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Foreground="{Binding TextBrush}" FontSize="11" Opacity="0.9" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <WrapPanel Margin="0,12,0,-8">
                            <Button Content="Wipe and reuse..." Command="{Binding WipeAndReuseCommand}" ToolTip="Clean, convert and make one formatted partition that fills the disk." ToolTipService.ShowOnDisabled="True" Margin="0,0,8,8" />
                            <Button Content="Create partition..." Command="{Binding CreatePartitionCommand}" ToolTip="New partition in the free space." ToolTipService.ShowOnDisabled="True" Margin="0,0,8,8" />
                            <Button Content="Clean" Command="{Binding CleanCommand}" ToolTip="Remove all partitions." ToolTipService.ShowOnDisabled="True" Margin="0,0,8,8" />
                            <Button Click="OpenMenu_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="More" />
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Margin="8,2,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Clean all" Command="{Binding CleanAllCommand}" ToolTip="Remove all partitions and zero every sector. Can take hours." ToolTipService.ShowOnDisabled="True" />
                                        <MenuItem Header="Convert GPT / MBR..." Command="{Binding ConvertCommand}" ToolTip="Switch the partition style. Cleans the disk first if needed." ToolTipService.ShowOnDisabled="True" />
                                        <Separator />
                                        <MenuItem Header="{Binding SelectedDisk.OnlineActionText}" Command="{Binding ToggleOnlineCommand}" ToolTip="{Binding SelectedDisk.OnlineActionTip}" ToolTipService.ShowOnDisabled="True" />
                                        <MenuItem Header="{Binding SelectedDisk.ReadOnlyActionText}" Command="{Binding ToggleReadOnlyCommand}" ToolTip="{Binding SelectedDisk.ReadOnlyActionTip}" ToolTipService.ShowOnDisabled="True" />
                                        <MenuItem Header="Change disk ID..." Command="{Binding ChangeDiskIdCommand}" ToolTip="New GPT GUID or MBR signature. Fixes ID clashes after cloning." ToolTipService.ShowOnDisabled="True" />
                                        <MenuItem Header="Detach" Command="{Binding DetachCommand}" ToolTip="Unmount this virtual disk." ToolTipService.ShowOnDisabled="True" Visibility="{Binding SelectedDisk.DetachVisibility}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Partitions -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Partitions" Style="{StaticResource SectionText}" Margin="0,0,0,8" />
                        <Grid>
                            <DataGrid x:Name="PartitionGrid"
                                      ItemsSource="{Binding SelectedDisk.Partitions}"
                                      SelectedItem="{Binding SelectedPartition}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      VerticalScrollBarVisibility="Disabled"
                                      MinHeight="96">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40" />
                                    <DataGridTextColumn Header="Letter" Binding="{Binding LetterText}" Width="62" />
                                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*" MinWidth="90" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="1.4*" MinWidth="120" />
                                    <DataGridTextColumn Header="File system" Binding="{Binding FileSystemText}" Width="*" MinWidth="104" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="84" />
                                    <DataGridTextColumn Header="Free" Binding="{Binding FreeText}" Width="84" />
                                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="1.5*" MinWidth="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No partitions."
                                       Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,28,0,0"
                                       Visibility="{Binding SelectedDisk.HasNoPartitions, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <WrapPanel Margin="0,12,0,-8">
                            <Button Content="Format..." Command="{Binding FormatCommand}" ToolTip="New file system. Erases the partition." ToolTipService.ShowOnDisabled="True" Margin="0,0,8,8" />
                            <Button Content="Delete" Command="{Binding DeleteCommand}" ToolTip="Remove the partition. Protected types use override." ToolTipService.ShowOnDisabled="True" Margin="0,0,8,8" />
                            <Button Content="Drive letter..." Command="{Binding ChangeLetterCommand}" ToolTip="Assign or change the drive letter." ToolTipService.ShowOnDisabled="True" Margin="0,0,8,8" />
                            <Button Content="Extend..." Command="{Binding ExtendCommand}" ToolTip="Grow into free space right after it. NTFS and ReFS only." ToolTipService.ShowOnDisabled="True" Margin="0,0,8,8" />
                            <Button Content="Shrink..." Command="{Binding ShrinkCommand}" ToolTip="Make it smaller and leave free space after it. NTFS only." ToolTipService.ShowOnDisabled="True" Margin="0,0,8,8" />
                            <Button Click="OpenMenu_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="More" />
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Margin="8,2,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Remove letter" Command="{Binding RemoveLetterCommand}" ToolTip="Unmount the drive letter. The data stays." ToolTipService.ShowOnDisabled="True" />
                                        <MenuItem Header="Change type..." Command="{Binding ChangeTypeCommand}" ToolTip="Change the partition type ID (set id)." ToolTipService.ShowOnDisabled="True" />
                                        <MenuItem Header="GPT attributes..." Command="{Binding GptAttributesCommand}" ToolTip="Hidden, read-only, no default letter and other GPT flags." ToolTipService.ShowOnDisabled="True" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- diskpart output -->
        <Expander Grid.Row="2" Header="diskpart output" Margin="0,12,0,0" IsExpanded="{Binding IsLogExpanded, Mode=TwoWay}">
            <TextBox Text="{Binding LogText, Mode=OneWay}"
                     IsReadOnly="True"
                     FontFamily="{StaticResource MonoFont}"
                     FontSize="12"
                     Height="180"
                     Margin="0,8,0,0"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
        </Expander>

        <!-- Status bar -->
        <DockPanel Grid.Row="3" Margin="2,10,2,0">
            <TextBlock DockPanel.Dock="Right" Text="flyte" Style="{StaticResource CaptionText}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" />
        </DockPanel>
    </Grid>
</Window>
